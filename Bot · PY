# ── Conseil IA via Pollinations.ai (100% gratuit, aucune clé) ─────────────────
async def get_ai_advice(user_id: int, symbols: list) -> str:
    import aiohttp
    import urllib.parse

    quotes = [q for q in [await mkt.get_quote(s) for s in symbols] if q]
    if not quotes:
        return "❌ Impossible de récupérer les données pour ces symboles."

    settings      = usr.get(user_id)
    portfolio     = settings.get("portfolio", [])

    market_text = "\n".join(
        f"{q['symbol']}: {format_price(q['price'])} ({format_change(q.get('changePercent', 0))}% aujourd'hui), "
        f"volume: {q.get('volume', 0):,}"
        for q in quotes
    )
    portfolio_ctx = ""
    if portfolio:
        portfolio_ctx = "\nPortfolio utilisateur : " + ", ".join(
            f"{p['qty']}x {p['symbol']} acheté à {p.get('buy_price', 'inconnu')}"
            for p in portfolio
        )

    system_prompt = (
        "Tu es Iris, une conseillère en trading expérimentée et directe. "
        "Tu analyses les données de marché et donnes des conseils concis, honnêtes et nuancés. "
        "Tu rappelles toujours que ce ne sont pas des conseils financiers professionnels. "
        "Tu réponds en français avec des emojis pour structurer. Maximum 400 mots."
    )

    user_prompt = (
        f"Analyse ces actifs et donne un conseil de trading :\n\n{market_text}{portfolio_ctx}\n\n"
        "Donne : 1) Analyse rapide 2) Points d'attention 3) Ce que tu ferais"
    )

    try:
        # Pollinations.ai — API texte gratuite, aucune clé requise
        payload = {
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user",   "content": user_prompt},
            ],
            "model":  "openai",   # modèle GPT-4o via Pollinations
            "seed":   42,
            "private": True,      # ne pas logger la conversation
        }

        async with aiohttp.ClientSession() as session:
            async with session.post(
                "https://text.pollinations.ai/openai",
                json=payload,
                timeout=aiohttp.ClientTimeout(total=30),
                headers={"Content-Type": "application/json"},
            ) as resp:
                if resp.status != 200:
                    return f"❌ Erreur Pollinations ({resp.status}). Réessaie dans quelques secondes."
                data = await resp.json()

        return data["choices"][0]["message"]["content"]

    except asyncio.TimeoutError:
        return "⏱️ L'IA met trop de temps à répondre. Réessaie dans quelques secondes."
    except Exception as e:
        return f"❌ Erreur IA : {e}"


# ── Boutons Discord ────────────────────────────────────────────────────────────
class LiveView(discord.ui.View):
    def __init__(self, user_id: int):
        super().__init__(timeout=None)
        self.user_id = user_id

    @discord.ui.button(label="🔄 Actualiser", style=discord.ButtonStyle.secondary)
    async def refresh(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer()
        settings = usr.get(self.user_id)
        embed    = await build_market_embed(mkt, settings, self.user_id)
        await interaction.message.edit(embed=embed)

    @discord.ui.button(label="➕ Ajouter", style=discord.ButtonStyle.primary)
    async def add_sym(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_message(
            "Tape `!iris settings add SYMBOLE` pour ajouter un actif.", ephemeral=True
        )

    @discord.ui.button(label="🤖 Conseil IA", style=discord.ButtonStyle.success)
    async def ai_advice(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer(ephemeral=True)
        reply = await get_ai_advice(
            interaction.user.id,
            usr.get(interaction.user.id).get("watchlist", [])
        )
        await interaction.followup.send(reply, ephemeral=True)


