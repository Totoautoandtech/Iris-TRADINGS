@bot.command(name="portfolio")
async def cmd_portfolio(ctx, sub: str = "view", *args):
    user_id = ctx.author.id
    sub     = sub.lower()

    if sub == "add" and len(args) >= 2:
        symbol = args[0].upper()
        try:
            qty   = float(args[1])
            price = float(args[2]) if len(args) >= 3 else None
        except ValueError:
            return await ctx.send("❌ Quantité ou prix invalide.")
        usr.add_position(user_id, symbol, qty, price)
        return await ctx.send(f"✅ **{qty}x {symbol}**" + (f" @ {price}" if price else "") + " ajouté.")

    if sub == "remove" and args:
        usr.remove_position(user_id, args[0].upper())
        return await ctx.send(f"🗑️ **{args[0].upper()}** retiré.")

    settings  = usr.get(user_id)
    portfolio = settings.get("portfolio", [])
    if not portfolio:
        return await ctx.send(
            "📭 Portfolio vide.\n"
            "Ajoute : `!iris portfolio add SYMBOLE QUANTITE PRIX_ACHAT`"
        )

    positions = []
    for pos in portfolio:
        data = await mkt.get_quote(pos["symbol"])
        if not data:
            continue
        current_val = data["price"] * pos["qty"]
        buy_val     = (pos.get("buy_price") or data["price"]) * pos["qty"]
        pnl         = current_val - buy_val
        pnl_pct     = (pnl / buy_val * 100) if buy_val else 0
        positions.append({**pos, "price": data["price"], "current_val": current_val, "pnl": pnl, "pnl_pct": pnl_pct})

    total_val = sum(p["current_val"] for p in positions)
    total_pnl = sum(p["pnl"] for p in positions)

    embed = discord.Embed(title="💼 Ton Portfolio", color=0x00b894 if total_pnl >= 0 else 0xff7675)
    for p in positions:
        sign = "+" if p["pnl_pct"] >= 0 else ""
        embed.add_field(
            name=f"{get_emoji(p['pnl_pct'])} {p['symbol']}",
            value=(
                f"{p['qty']} × {format_price(p['price'])} = **{format_price(p['current_val'])}**\n"
                f"P&L : {format_change(p['pnl'])} ({sign}{p['pnl_pct']:.2f}%)"
            ),
            inline=True,
        )
    embed.add_field(name="💰 Valeur totale",                               value=f"**{format_price(total_val)}**",  inline=True)
    embed.add_field(name=f"{'📈' if total_pnl >= 0 else '📉'} P&L total", value=f"**{format_change(total_pnl)}**", inline=True)
    embed.set_footer(text="Iris Trading • Données temps réel")
    embed.timestamp = discord.utils.utcnow()
    await ctx.send(embed=embed)


@bot.command(name="alert")
async def cmd_alert(ctx, symbol: str = None, threshold: str = None):
    if not symbol or not threshold:
        return await ctx.send("Usage : `!iris alert SYMBOLE SEUIL` (ex: `!iris alert AAPL 3`)")
    try:
        t = float(threshold)
    except ValueError:
        return await ctx.send("❌ Seuil invalide.")
    usr.add_custom_alert(ctx.author.id, symbol.upper(), t)
    await ctx.send(f"🔔 Alerte créée : DM si **{symbol.upper()}** bouge de **{t}%**.")


