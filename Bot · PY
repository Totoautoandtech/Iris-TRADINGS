from utils import format_price, format_change, get_emoji, build_market_embed

load_dotenv()

DISCORD_TOKEN  = os.getenv("DISCORD_TOKEN")
ALERT_COOLDOWN = 5 * 60  # 5 min entre deux alertes par symbole/user

intents = discord.Intents.default()
intents.message_content = True
intents.members = True

bot = commands.Bot(command_prefix="!iris ", intents=intents, help_command=None)
mkt = MarketData()
usr = UserSettings()

live_messages: dict = {}
alert_cooldowns: dict = {}

# ── Démarrage ─────────────────────────────────────────────────────────────────
@bot.event
async def on_ready():
    print(f"✅ Iris Trading connectée : {bot.user}")
    mkt.start()
    update_live_loop.start()
    check_alerts_loop.start()

# ── Tâches ────────────────────────────────────────────────────────────────────
@tasks.loop(seconds=30)
async def update_live_loop():
    for key, info in list(live_messages.items()):
        try:
            channel = bot.get_channel(info["channel_id"])
            if not channel:
                live_messages.pop(key, None)
                continue
            msg      = await channel.fetch_message(info["message_id"])
            settings = usr.get(info["user_id"])
            embed    = await build_market_embed(mkt, settings, info["user_id"])
            await msg.edit(embed=embed)
        except Exception as e:
            print(f"Erreur update live: {e}")

@tasks.loop(seconds=60)
async def check_alerts_loop():
    for user_id, settings in usr.get_all():
        if not settings.get("alerts_enabled", True):
            continue
        threshold = settings.get("alert_threshold", 3.0)
        symbols   = list(set(
            settings.get("watchlist", []) +
            [p["symbol"] for p in settings.get("portfolio", [])]
        ))
        for symbol in symbols:
            data = await mkt.get_quote(symbol)
            if not data:
                continue
            change = abs(data.get("changePercent", 0))
            if change < threshold:
                continue
            cd   = alert_cooldowns.setdefault(user_id, {})
            last = cd.get(symbol, 0)
            if time.time() - last < ALERT_COOLDOWN:
                continue
            cd[symbol] = time.time()
            try:
                user      = await bot.fetch_user(user_id)
                direction = "🚀 Hausse" if data["changePercent"] > 0 else "📉 Baisse"
                await user.send(
                    f"**{direction} notable — {symbol}**\n"
                    f"Variation : **{format_change(data['changePercent'])}%** | "
                    f"Prix : **{format_price(data['price'])}**\n\n"
                    f"Tape `!iris conseil {symbol}` pour un avis IA."
                )
            except Exception:
                pass

