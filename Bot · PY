@bot.command(name="settings")
async def cmd_settings(ctx, sub: str = "view", *args):
    user_id = ctx.author.id
    sub     = sub.lower()

    if sub == "view":
        s = usr.get(user_id)
        embed = discord.Embed(title="⚙️ Tes Paramètres Iris Trading", color=0x6C5CE7)
        embed.add_field(name="📊 Watchlist",    value=", ".join(s["watchlist"]) or "Vide",         inline=False)
        embed.add_field(name="🔔 Alertes",      value="✅ On" if s["alerts_enabled"] else "❌ Off", inline=True)
        embed.add_field(name="📈 Seuil alerte", value=f"{s['alert_threshold']}%",                  inline=True)
        embed.add_field(name="💱 Devise",       value=s["currency"],                                inline=True)
        embed.set_footer(text="Ces paramètres s'appliquent uniquement à toi")
        return await ctx.send(embed=embed)

    if sub == "add" and args:
        symbol = args[0].upper()
        valid  = await mkt.is_valid(symbol)
        if not valid:
            return await ctx.send(f"❌ Symbole `{symbol}` introuvable.")
        usr.add_to_watchlist(user_id, symbol)
        return await ctx.send(f"✅ **{symbol}** ajouté à ta watchlist !")

    if sub == "remove" and args:
        usr.remove_from_watchlist(user_id, args[0].upper())
        return await ctx.send(f"🗑️ **{args[0].upper()}** retiré.")

    if sub == "alert" and args:
        val = args[0].lower()
        if val == "on":
            usr.update(user_id, {"alerts_enabled": True})
            return await ctx.send("🔔 Alertes **activées**.")
        if val == "off":
            usr.update(user_id, {"alerts_enabled": False})
            return await ctx.send("🔕 Alertes **désactivées**.")
        try:
            usr.update(user_id, {"alert_threshold": float(val)})
            return await ctx.send(f"📊 Seuil réglé à **{val}%**.")
        except ValueError:
            pass

    if sub == "currency" and args:
        usr.update(user_id, {"currency": args[0].upper()})
        return await ctx.send(f"💱 Devise changée en **{args[0].upper()}**.")

    await ctx.send(
        "**Sous-commandes :**\n"
        "`!iris settings view` · `!iris settings add SYMBOLE` · `!iris settings remove SYMBOLE`\n"
        "`!iris settings alert on/off` · `!iris settings alert 3` · `!iris settings currency EUR`"
    )


